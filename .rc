PATH=$PATH:$HOME/.bin:$HOME/.local/bin
[ ! -s $HOME/.cargo/bin ] || PATH=$PATH:$HOME/.cargo/bin

[ ! -s /opt/ros/humble/setup.$CURRENT_SHELL ] || source /opt/ros/humble/setup.$CURRENT_SHELL
[ ! -s $HOME/ros2_ws/install/setup.$CURRENT_SHELL ] || source $HOME/ros2_ws/install/setup.$CURRENT_SHELL
export ROS_DOMAIN_ID=41
export ROS_LOCALHOST_ONLY=1
export ROS_RUNTIME_DIRECTORY="$HOME/scorpio_runtime"
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=${CYCLONEDDS_URI:-"<CycloneDDS><Domain><Discovery><ParticipantIndex>auto</ParticipantIndex><MaxAutoParticipantIndex>100</MaxAutoParticipantIndex></Discovery></Domain></CycloneDDS>"}
export WEB_APP_PATH=$HOME/web_app


if command -v ccache &> /dev/null; then
  export CC="/usr/lib/ccache/gcc"
  export CXX="/usr/lib/ccache/g++"
  export CCACHE_DIR="$HOME/.cache/ccache/"
fi

if command -v tmux &> /dev/null; then
  tmux source "$HOME/.tmux.conf" &> /dev/null
fi

alias mountnfs="sudo mount 10.0.0.1:/mnt/nfs/ /mnt/nfs"
alias ssr="ssh nvidia@10.0.0.1"
alias ssp="ssh ubuntu@10.0.0.10"
# alias ssb="ssh nvidia@10.0.0.19"

alias cls=clear
alias rdep="cd $HOME/ros2_ws && (sudo rosdep init; rosdep update; rosdep install --from-paths src --ignore-src -r -y)"
alias rtest="colcon_test $HOME/ros2_ws/"
alias build="colcon_build $HOME/ros2_ws/"
alias base='docker compose -f $HOME/ros2_ws/src/core/docker_base/docker-compose.yml'
alias grep='grep --color=auto'
alias web-app='docker run --rm -v "$WEB_APP_PATH"/:/usr/local/apache2/htdocs/ -p 80:80 httpd:alpine'
alias spt=spotify_player
alias cout='cowsay_lolcat'

case "$XDG_SESSION_TYPE" in
  "x11")
    if command -v xclip &> /dev/null; then
      alias cpy='xclip -sel clip'
      alias pst='xclip -sel clip -o'
    fi ;;
  "wayland")
    if command -v wl-paste &> /dev/null; then
      alias cpy='wl-copy'
      alias pst='wl-paste'
    fi ;;
esac
